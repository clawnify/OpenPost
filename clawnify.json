{
  "$schema": "https://app.clawnify.com/schema/v1/clawnify.json",
  "name": "OpenPost",
  "description": "Social media post scheduler with a calendar view, multi-channel composer, queue management, and analytics. An open alternative to Buffer and Hypefury.",
  "icon": "icon.svg",
  "app": {
    "framework": "preact+hono",
    "database": true,
    "storage": true,
    "credentials": ["twitter", "linkedin", "instagram", "tiktok", "bluesky"]
  },
  "api": {
    "public_routes": [
      { "path": "/api/internal/publish", "methods": ["POST"] },
      { "path": "/api/uploads/*", "methods": ["GET"] }
    ]
  }
}
